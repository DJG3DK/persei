# Copy to .env in the repo root, then `docker compose up -d`.

# The only paid dependency. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# The folder the agent works in, ON THE HOST. A repository already here is
# visible to it as /projects/<name>, and one it clones from GitHub for you
# (from the dashboard's Projects page) lands here too. An empty folder is
# fine if everything you have is on GitHub.
#   Linux/macOS:  PROJECTS_DIR=/home/you/code
#   Windows:      PROJECTS_DIR=C:\Users\you\code
PROJECTS_DIR=

# Reachability. The default binds to localhost only: the dashboard is for the
# machine it runs on. Set 0.0.0.0 deliberately, and put something in front of
# it if you do.
BIND_ADDRESS=127.0.0.1
AGENT_PORT=8100

# Linux: your own ids (`id -u`, `id -g`), so what the agent and the review
# services write into PROJECTS_DIR is yours rather than root's. Leave blank
# on Docker Desktop, where the bind mount does not care.
PUID=
PGID=

# What one task's commands or one check may use. The desktop app sets these
# from the machine's size; the defaults suit a small server.
SANDBOX_CPUS=2
SANDBOX_MEMORY=2g
# Images a project's own `sandbox_image` may name, beyond the sandbox image
# and the toolchain images in docker/stack-images.json: comma-separated. The
# sandbox launcher starts nothing that is not on that list.
SANDBOX_EXTRA_IMAGES=

# Optional
ADMIN_EMAIL=admin@example.com
# Who the agent's commits are from. Your own name and the address your
# GitHub account knows (or its noreply one, ID+user@users.noreply.github.com).
# Blank: "Persei" and ADMIN_EMAIL.
GIT_USER_NAME=
GIT_USER_EMAIL=
DEFAULT_BUDGET_USD=10.00
# Leave these two blank: a random one of each is generated on first boot and
# kept in the bundlesecrets volume. Set them only to use values of your own.
POSTGRES_PASSWORD=
MODEL_ROUTER_KEY=
GITHUB_TOKEN=

# Password-reset email. Leave blank and reset against the database instead
# (INSTALL.md section 6a).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# The SEED for the router's config, read on the first boot only. Unset uses
# the committed example, which is a working default rather than a stub --
# so `docker compose up` works on a fresh copy. After the first boot the
# live file is config.yaml in the routerconfig volume, which the Models page
# writes; changing this later does nothing until that volume is emptied
# (docker/README.md, "Model pins").
#   ROUTER_CONFIG=./services/model-router/config.yaml

# Installed before 2026-09-28? The compose project was three-d-agent then
# and its volumes carry that prefix; these two keep that data in use
# (docker/README.md, "Upgrading"). Leave them out on a fresh install.
#   COMPOSE_PROJECT_NAME=three-d-agent
#   POSTGRES_DB=three_d_agent

# Licensed features, comma-separated. Accounts beyond the first are one
# (`multi-user`); without it the routes that create them refuse and the
# page is not shown. Existing accounts always keep working.
TEKTONIX_FEATURES=
