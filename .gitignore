# Secrets — never commit
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# The router's live config. The Models page rewrites it on every repin, so
# tracking it turned every model change into a diff the operator had to
# explain -- and an upgrade could overwrite the pins they chose. The shape is
# tracked instead, as services/model-router/config.example.yaml, which
# install.sh copies here on a fresh install.
services/model-router/config.yaml

# Local run artifacts
*.log
# Telemetry this deployment writes about itself: one line per tool result,
# read back by the Analytics page (agent/tool_events.py). Size-trimmed, local,
# and nobody else's business.
logs/
# A stray root-level one appears the moment anything runs npx/vitest from the
# repo root instead of frontend/ -- it is a cache, never source.
node_modules/
projects.json
.agent-git-excludes

# Per-deployment memory content (see memory/*.example.md for the template)
memory/*.md
!memory/*.example.md

# Timestamped edit backups (kept outside the repo in /root/repo-backups)
*.bak
*.bak-*

# Runtime data written by the app, regenerable and deployment-specific:
#   last_consolidation.json  - written by scripts/consolidation-cron.sh each run
#   forced_tool_call_probe.json - cache of scripts/probe_forced_tool_call.py.
#     The verdicts that MATTER are committed as STRICT_VERIFIED_OK/BAD in
#     agent/model_config.py; this file is just the full sweep, refreshable from
#     the Models page.
data/

# Deployment-specific skills: your own domain knowledge (architecture notes for
# YOUR repos, house rules, anything naming your systems). Kept out of the
# public repo the same way projects.json and memory/*.md are.
# skills/vendor/ (third-party, license-pinned) and the examples DO ship.
skills/local/
!skills/local/README.md
!skills/local/targets.example.json

# Per-deployment overrides for the review/deploy services: your repo paths,
# credential filenames and real check commands. See the .example files.
services/*/builtin-projects.local.js

# Per-project SSH deploy keys (agent/deploy_keys.py). Private keys — never
# committed, and the app has no endpoint that returns one.
keys/

# Archived project memory (agent/project_removal.py). Operator data, like
# keys/: it is what a removed project knew, kept so re-adding it is a
# continuation rather than a fresh start.
archives/

# Which services the health watchdog watches: this install's own URLs and
# pm2 names. scripts/watchdog-services.example.json shows the shape.
scripts/watchdog-services.local.json

# A symlink named .venv is NOT matched by ".venv/" above (that matches
# directories only), so a worktree convenience symlink slipped past git add -A
# and, on merge, replaced the real venv with a self-referential link.
.venv

# Coverage reports are generated by `npm run test:coverage`
frontend/coverage/
# ...and by pytest-cov (CI's python job; `pytest --cov=agent` locally)
.coverage
.coverage.*
coverage.xml
htmlcov/
# first-run admin password, written once by agent/server.py (mode 0600)
.initial-admin-password
# database dumps from scripts/backup.sh (keep them off the repo and off GitHub)
backups/

# release tarballs from scripts/package_release.sh
/dist/

# The model router's own virtualenv. Its whole point is a dependency set that
# is NOT the agent's, so it gets its own.
services/model-router/venv/

# The router's own secrets and its billed-cost ledger.
services/model-router/.env
services/model-router/logs/

# The vtracer binary for the logo tools -- 3MB, platform-specific, and
# fetched by services/logoloom/fetch-vtracer.sh rather than committed.
services/logoloom/vendor/

# Eval run reports. The suite is committed; a particular run's output is this
# deployment's own record, and a dozen JSON blobs per week is not repo history.
/logs/evals/

# The desktop app (app/): build output and dependencies.
app/node_modules/
app/src-tauri/target/
app/src-tauri/gen/
# Written by tauri-build from build.rs's command list on every build.
app/src-tauri/permissions/autogenerated/

# The household chat app: private, its own git history, never part of this repository.
/chat/
