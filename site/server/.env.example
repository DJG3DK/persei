# Copy to .env and fill in. Gitignored: it names the database.
NEWSLETTER_PG_DSN=postgresql://user:password@localhost:5432/yourdb
SITE_URL=https://perseiagent.ai
NEWSLETTER_PORT=8300
# Signs the download cookie. Without it the key is random per process, so every
# restart -- pm2's 150 MB memory cap included -- sends everyone back to the form.
# Generate once: python3 -c "import secrets; print(secrets.token_hex(32))"
DOWNLOAD_COOKIE_SECRET=
